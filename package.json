{
  "name": "fluentflow",
  "private": true,
  "version": "0.1.0",
  "description": "Cross-platform flashcard learning app with on-device AI example generation",
  "workspaces": [
    "packages/*",
    "apps/server",
    "apps/mobile"
  ],
  "scripts": {
    "build": "npm run build -w @fluentflow/core",
    "test": "npm run test -w @fluentflow/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "server": "npm run dev -w @fluentflow/server",
    "mobile": "npm run start -w @fluentflow/mobile",
    "prepare-model": "node scripts/prepare-model.mjs"
  },
  "engines": { "node": ">=20" }
}
