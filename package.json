{
  "name": "fluentflow",
  "private": true,
  "version": "0.1.0",
  "description": "Desktop flashcard learning app with a local dictionary and hosted example generation",
  "workspaces": [
    "packages/*",
    "apps/server",
    "apps/mobile"
  ],
  "scripts": {
    "build": "npm run build -w @fluentflow/core",
    "test": "npm run test -w @fluentflow/core && npm run test -w @fluentflow/server && npm run test -w @fluentflow/mobile && npm run test:desktop",
    "test:desktop": "node scripts/vendor-core.mjs --skip-build && node --test \"apps/desktop/test/*.test.mjs\"",
    "verify": "npm run build -w @fluentflow/core && node scripts/verify-flow.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "server": "npm run dev -w @fluentflow/server",
    "web": "npm run web -w @fluentflow/mobile",
    "dev": "node scripts/dev-web.mjs",
    "web:export": "npm run export:web -w @fluentflow/mobile",
    "firebase:deploy": "npm run web:export && npx firebase-tools deploy --only hosting,firestore:rules,firestore:indexes",
    "desktop": "node scripts/desktop-build.mjs dist",
    "desktop:win": "node scripts/desktop-build.mjs dist:win",
    "desktop:mac": "node scripts/desktop-build.mjs dist:mac",
    "desktop:pack": "node scripts/desktop-build.mjs pack",
    "desktop:refresh": "node scripts/refresh-desktop.mjs",
    "desktop:vendor": "node scripts/vendor-core.mjs",
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "fetch-dictionaries": "node scripts/fetch-dictionaries.mjs",
    "check-cloud-model": "node scripts/check-cloud-model.mjs",
    "icons": "node scripts/make-icons.mjs",
    "sample-deck": "npm run build -w @fluentflow/core && node scripts/make-sample-deck.mjs",
    "verify:web": "node scripts/verify-web.mjs",
    "verify:desktop": "node scripts/verify-desktop.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react-native": "0.86.3",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "puppeteer-core": "^24.43.1"
  }
}
