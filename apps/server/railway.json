{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/Dockerfile",
      "/package.json",
      "/package-lock.json",
      "/apps/server/**",
      "/apps/mobile/**",
      "/packages/core/**"
    ]
  },
  "deploy": {
    "startCommand": "node apps/server/src/index.ts",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE"
  }
}
