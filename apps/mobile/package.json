{
  "name": "@fluentflow/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --web",
    "web": "expo start --web",
    "export:web": "expo export --platform web --clear",
