{
  "name": "@fluentflow/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Spaced-repetition flashcards for language learning",
  "author": "Alan Reyes",
  "main": "main.js",
  "scripts": {
    "build:core": "node ../../scripts/vendor-core.mjs",
    "build:icon": "node ../../scripts/make-icons.mjs",
    "make-icon": "node scripts/make-icon.mjs",
    "build:web": "cd ../mobile && npx expo export --platform web --output-dir ../desktop/web --clear",
    "build": "npm run build:icon && npm run build:core && npm run build:web",
    "test": "node --test \"test/*.test.mjs\"",
    "start": "node scripts/launch.mjs",
    "dev": "cross-env FLUENTFLOW_DEV_URL=http://localhost:8081 node scripts/launch.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^44.3.0",
    "electron-builder": "^25.1.8",
    "resedit": "^1.7.2"
  },
  "build": {
    "appId": "com.fluentflow.desktop",
    "productName": "FluentFlow",
    "copyright": "Copyright (c) 2026 Alan Reyes",
    "afterPack": "scripts/after-pack.js",
    "publish": {
      "provider": "github",
      "owner": "alanreyes24",
      "repo": "fluentflow"
    },
    "files": [
      "*.js",
      "src/**/*",
      "vendor/**/*",
      "web/**/*",
      "node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "darkModeSupport": true,
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": null,
      "notarize": false,
      "artifactName": "FluentFlow-${version}-${arch}.${ext}"
    },
    "dmg": {
      "icon": "build/icon.icns",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "FluentFlow-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "FluentFlow-${version}-portable.${ext}"
    },
    "asar": false
  },
  "dependencies": {
    "@fluentflow/core": "file:../../packages/core",
    "electron-updater": "^6.8.9"
  },
  "license": "MIT"
}
