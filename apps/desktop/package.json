{
  "name": "@fluentflow/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Windows and macOS desktop shell for FluentFlow",
  "main": "main.js",
  "scripts": {
    "build:web": "cd ../mobile && npx expo export --platform web --output-dir ../desktop/web --clear",
    "start": "node scripts/launch.mjs",
    "dev": "cross-env FLUENTFLOW_DEV_URL=http://localhost:8081 node scripts/launch.mjs",
    "pack": "npm run build:web && electron-builder --dir",
    "dist": "npm run build:web && electron-builder",
    "dist:win": "npm run build:web && electron-builder --win",
    "dist:mac": "npm run build:web && electron-builder --mac",
    "fetch-model": "node ../../scripts/fetch-desktop-model.mjs"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^44.1.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.fluentflow.desktop",
    "productName": "FluentFlow",
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "*.js",
      "web/**/*",
      "node_modules/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education",
      "darkModeSupport": true,
      "identity": null,
      "artifactName": "FluentFlow-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "FluentFlow-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "FluentFlow-${version}-portable.${ext}"
    },
    "asar": false
  },
  "dependencies": {
    "@fluentflow/core": "file:../../packages/core",
    "onnxruntime-node": "^1.29.0"
  },
  "allowScripts": {
    "onnxruntime-node": false
  }
}
