{
  "name": "@fluentflow/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Windows and macOS desktop shell for FluentFlow",
  "main": "main.js",
  "scripts": {
    "build:web": "cd ../mobile && npx expo export --platform web --output-dir ../desktop/web --clear",
    "start": "node scripts/launch.mjs",
    "dev": "cross-env FLUENTFLOW_DEV_URL=http://localhost:8081 node scripts/launch.mjs",
    "pack": "npm run build:web && electron-builder --dir",
    "dist": "npm run build:web && electron-builder",
    "dist:win": "npm run build:web && electron-builder --win",
    "dist:mac": "npm run build:web && electron-builder --mac",
    "make-icon": "node scripts/make-icon.mjs"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^44.1.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.fluentflow.desktop",
    "productName": "FluentFlow",
    "afterPack": "scripts/after-pack.cjs",
    "publish": {
      "provider": "github",
      "owner": "alanreyes24",
      "repo": "fluentflow"
    },
    "files": [
      "*.js",
      "web/**/*",
      "node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        },
        {
          "target": "zip",
          "arch": ["arm64"]
        }
      ],
      "category": "public.app-category.education",
      "darkModeSupport": true,
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": null,
      "notarize": false,
      "artifactName": "FluentFlow-${version}-${arch}.${ext}"
    },
    "dmg": {
      "icon": "build/icon.icns",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "FluentFlow-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "FluentFlow-${version}-portable.${ext}"
    },
    "asar": false
  },
  "dependencies": {
    "@fluentflow/core": "file:../../packages/core",
    "electron-updater": "^6.8.9"
  }
}
