<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements.

  ONNX Runtime JITs its execution kernels, and the model runs in the Electron
  main process, so the process needs to allocate executable memory and load an
  unsigned native .node (the app itself is not signed with a Developer ID yet,
  and `asar: false` leaves the binding loose on disk). Chromium's own V8 JIT
  needs the same allowance.

  These are the standard Electron + native-addon set. They take effect once
  `hardenedRuntime` signing is active; the ad-hoc path in scripts/after-pack.cjs
  applies them too so the two builds behave the same.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
</dict>
</plist>
