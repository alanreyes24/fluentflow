# Sync server configuration. Copy to .env and fill in to run against Firebase.
#
# With none of these set, the server starts in local mode: an in-memory store
# and a permissive dev token. That is enough to run and test the whole app
# without a Firebase project, and it refuses to start if NODE_ENV=production.

# --- Firebase (server) ------------------------------------------------------
FIREBASE_PROJECT_ID=
# Path to a service-account JSON file. Omit on Cloud Run, where the metadata
# server provides credentials.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# --- Local development against the emulator suite ---------------------------
# firebase emulators:start   then uncomment:
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# --- Server ----------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
# Comma-separated, or * to allow any origin. Narrow this in production.
CORS_ORIGINS=*
MAX_UPLOAD_BYTES=209715200

# Force a mode instead of inferring one: firebase | local
# FLUENTFLOW_MODE=local

# --- Expo/Firebase client build ---------------------------------------------
# These values are public Firebase web-app configuration, not service-account
# credentials. They are embedded into the browser/Electron/native bundle.
# Set them before `npm run web:export` or a desktop build.
# FLUENTFLOW_FIREBASE_API_KEY=
# FLUENTFLOW_FIREBASE_AUTH_DOMAIN=
# FLUENTFLOW_FIREBASE_PROJECT_ID=
# FLUENTFLOW_FIREBASE_STORAGE_BUCKET=
# FLUENTFLOW_FIREBASE_MESSAGING_SENDER_ID=
# FLUENTFLOW_FIREBASE_APP_ID=
# Expo web exports also need the same values with the EXPO_PUBLIC_ prefix so
# they are inlined into the browser bundle.
# EXPO_PUBLIC_FLUENTFLOW_FIREBASE_API_KEY=
# EXPO_PUBLIC_FLUENTFLOW_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FLUENTFLOW_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FLUENTFLOW_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FLUENTFLOW_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FLUENTFLOW_FIREBASE_APP_ID=
# Leave this unset for production; it is only needed for browser Anki import
# and the local AI proxy.
# FLUENTFLOW_API_BASE_URL=
