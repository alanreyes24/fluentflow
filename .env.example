# Optional configuration. Copy to .env; never commit the filled-in file.
# `npm run dev` loads the root .env. No cloud settings are needed to study locally.

# Local development API: keep permissive dev tokens on your own machine.
PORT=8787
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,app://fluentflow
MAX_UPLOAD_BYTES=209715200

# Optional browser AI proxy (server-side only; NEVER use EXPO_PUBLIC_ for this).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite

# Optional Firebase-backed standalone API. The app normally syncs directly
# through the Firebase client, so these are not needed for client-only sync.
# FLUENTFLOW_MODE=firebase
# FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Firebase CLIENT config: public browser-safe values from your own project.
# Fill in both sets before web exports or desktop builds.
# Never put service-account JSON, private keys, or Gemini keys here.
# FLUENTFLOW_FIREBASE_API_KEY=
# FLUENTFLOW_FIREBASE_AUTH_DOMAIN=
# FLUENTFLOW_FIREBASE_PROJECT_ID=
# FLUENTFLOW_FIREBASE_STORAGE_BUCKET=
# FLUENTFLOW_FIREBASE_MESSAGING_SENDER_ID=
# FLUENTFLOW_FIREBASE_APP_ID=
# EXPO_PUBLIC_FLUENTFLOW_FIREBASE_API_KEY=
# EXPO_PUBLIC_FLUENTFLOW_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FLUENTFLOW_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FLUENTFLOW_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FLUENTFLOW_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FLUENTFLOW_FIREBASE_APP_ID=

# Leave unset for a static production export. Development defaults to localhost.
# FLUENTFLOW_API_BASE_URL=http://localhost:8787
