# Sync server configuration. Copy to .env and fill in to run against Firebase.
#
# With none of these set, the server starts in local mode: an in-memory store
# and a permissive dev token. That is enough to run and test the whole app
# without a Firebase project, and it refuses to start if NODE_ENV=production.

# --- Firebase (server) ------------------------------------------------------
FIREBASE_PROJECT_ID=
# Path to a service-account JSON file. Omit on Cloud Run, where the metadata
# server provides credentials.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# --- Local development against the emulator suite ---------------------------
# firebase emulators:start   then uncomment:
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# --- Server ----------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
# Comma-separated, or * to allow any origin. Narrow this in production.
CORS_ORIGINS=*
MAX_UPLOAD_BYTES=209715200

# Force a mode instead of inferring one: firebase | local
# FLUENTFLOW_MODE=local
